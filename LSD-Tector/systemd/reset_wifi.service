# reset_wifi.service — PENDIENTE DE IMPLEMENTACIÓN
#
# Este servicio se activará al presionar un botón físico en la caja
# y levantará el portal hotspot de configuración WiFi para permitir
# reconfigurar la red sin necesidad de acceso físico al dispositivo.
#
# Implementación pendiente para próxima versión.

[Unit]
Description=BirdNET Reset WiFi via button press
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash /home/lsd/reset_wifi.sh

[Install]
WantedBy=multi-user.target
